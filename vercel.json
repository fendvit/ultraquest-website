{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/premium", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/open" },
    { "source": "/clubs/:path*", "destination": "/open" },
    { "source": "/events/:path*", "destination": "/open" },
    { "source": "/activity/:path*", "destination": "/open" },
    { "source": "/profile/:path*", "destination": "/open" },
    { "source": "/athlete/:path*", "destination": "/open" },
    { "source": "/races/:path*", "destination": "/open" }
  ]
}
